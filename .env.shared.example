APP_NAME="LW's by Bubur Kang LW"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=replace_with_cpanel_database
DB_USERNAME=replace_with_cpanel_username
DB_PASSWORD=replace_with_a_strong_password

# These drivers avoid requiring a Redis service on shared hosting.
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Internal address used by PHP to publish to the local Reverb process.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Hostnames only, comma separated; no scheme or path.
REVERB_ALLOWED_ORIGINS=example.com,www.example.com

# These are embedded in the frontend bundle during `npm run build`.
VITE_APP_NAME="${APP_NAME}"
VITE_BROADCAST_CONNECTION=reverb
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# If the host cannot run Reverb, use a hosted Pusher-compatible service:
# set BROADCAST_CONNECTION=pusher and VITE_BROADCAST_CONNECTION=pusher,
# then enter the service credentials below before building frontend assets.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MAIL_MAILER=smtp
MAIL_HOST=replace_with_smtp_host
MAIL_PORT=587
MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_password
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=replace_with_sender_address
MAIL_FROM_NAME="${APP_NAME}"

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Set true after entering the Midtrans production keys.
MIDTRANS_IS_PRODUCTION=true

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production

# Never run the development seeder in production.
SEEDER_DEFAULT_PASSWORD=
SEEDER_ADMIN_DEFAULT_PASSWORD=
